# Copie ce fichier en `.env` et remplis les valeurs.

# Ville à surveiller (n'importe quelle commune française)
CITY=Lyon
# Marge autour de la ville, en km (couvre les campus périphériques, ex. Villeurbanne)
MARGIN_KM=5

# Bot Telegram (voir README pour créer le bot et trouver le chat_id)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Optionnel — watchdog externe (https://healthchecks.io, gratuit)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optionnel — réglages avancés (valeurs par défaut ci-dessous)
# CHECK_INTERVAL=60
# JITTER=10
# FAILURES_BEFORE_ALERT=5
# DB_PATH=etat.db
# TOOL_ID=41
